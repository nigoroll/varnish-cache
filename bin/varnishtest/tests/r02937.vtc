vtest "#2937: Panic on OU pool failure"

server s1 {
	rxreq
	txresp
} -start

vinyl v1 -vcl+backend {} -start

vinyl v1 -cliok "param.set feature +http2"
vinyl v1 -cliok "debug.reqpool.fail F"

client c1 {
	send "GET / HTTP/1.1\r\n"
	send "Host: foo\r\n"
	send "Upgrade: h2c\r\n"
	send "HTTP2-Settings: AAMAAABkAAQAAP__\r\n"
	send "\r\n"
	rxresp
	expect resp.status == 101
	expect resp.http.upgrade == h2c
	expect resp.http.connection == Upgrade
	txpri
	expect_close
} -run
