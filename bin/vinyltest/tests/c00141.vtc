vtest "test ban obj.hfp"

server s0 {
	rxreq
	txresp -bodylen 5
} -dispatch

vinyl v1 -vcl+backend {
	sub vcl_deliver {
		set resp.http.X-hitpass = req.is_hitpass;
		set resp.http.X-hit = (obj.hits != 0);
	}

	sub vcl_backend_response {
		if (bereq.url ~ "^/hfp") {
			return (pass(1h));
		}
	}
} -start


# obj.hfp only accepts == and !=
vinyl v1 -clierr 106 "ban obj.hfp > true"
vinyl v1 -clierr 106 "ban obj.hfp ~ true"
# and only the true/false arguments
vinyl v1 -clierr 106 "ban obj.hfp == maybe"
vinyl v1 -clierr 106 "ban obj.hfp != 1"


vinyl v1 -cliok "param.set ban_lurker_age 0"
vinyl v1 -cliok "param.set ban_lurker_sleep 0.01"

# Hit-for-pass object: obj.hfp is true.

client c1 {
	txreq -url "/hfp1"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitpass == false
	expect resp.http.X-hit == false
} -run

vinyl v1 -expect n_object == 1

# Neither of these matches a hit-for-pass object.
vinyl v1 -cliok "ban obj.hfp == false"
vinyl v1 -cliok "ban obj.hfp != true"
vinyl v1 -expect bans_lurker_obj_killed == 0
vinyl v1 -expect n_object == 1

client c1 {
	txreq -url "/hfp1"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitpass == true
	expect resp.http.X-hit == false
} -run

# This one matches
vinyl v1 -cliok "ban obj.hfp == true"
vinyl v1 -expect bans_lurker_obj_killed == 1
vinyl v1 -expect n_object == 0

client c1 {
	txreq -url "/hfp1"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitpass == false
	expect resp.http.X-hit == false
} -run

# Another hit-for-miss object, this time killed by "!= false".

client c2 {
	txreq -url "/hfp2"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitpass == false
	expect resp.http.X-hit == false
} -run

vinyl v1 -expect n_object == 2
vinyl v1 -cliok "ban obj.hfp != false"
vinyl v1 -expect bans_lurker_obj_killed == 3
vinyl v1 -expect n_object == 0

# Regular cacheable object killed by "== false".
client c3 {
	txreq -url "/cache1"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitpass == false
	expect resp.http.X-hit == false
} -run

vinyl v1 -expect n_object == 1

# Neither of these matches a cacheable object.
vinyl v1 -cliok "ban obj.hfp == true"
vinyl v1 -cliok "ban obj.hfp != false"
vinyl v1 -expect bans_lurker_obj_killed == 3
vinyl v1 -expect n_object == 1

client c3 {
	txreq -url "/cache1"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitpass == false
	expect resp.http.X-hit == true
} -run

# This one matches
vinyl v1 -cliok "ban obj.hfp == false"
vinyl v1 -expect bans_lurker_obj_killed == 4
vinyl v1 -expect n_object == 0

client c3 {
	txreq -url "/cache1"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitpass == false
	expect resp.http.X-hit == false
} -run

# Another cacheable object, this time killed by "!= true".

client c4 {
	txreq -url "/cache2"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitpass == false
	expect resp.http.X-hit == false
} -run

vinyl v1 -expect n_object == 2

client c4 {
	txreq -url "/cache2"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitpass == false
	expect resp.http.X-hit == true
} -run

vinyl v1 -cliok "ban obj.hfp != true"
vinyl v1 -expect bans_lurker_obj_killed == 6
vinyl v1 -expect n_object == 0


client c4 {
	txreq -url "/cache2"
	rxresp
	expect resp.status == 200
	expect resp.http.X-hitpass == false
	expect resp.http.X-hit == false
} -run
