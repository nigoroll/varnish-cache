vtest "Append configurable Via header"

# XXX TEMP broken, will be fixed in next commit
feature cmd false

server s1 {
	rxreq
	expect req.http.via == \
		"1.1 v2 (Vinyl-Cache/${pkg_branch}), 1.1 v1 (Vinyl-Cache/${pkg_branch})"
	txresp
} -start

vinyl v1 -vcl+backend "" -start

vinyl v2 -vcl {
	backend v1 {
		.host = "${v1_sock}";
	}
} -start

client c1 -connect ${v2_sock} {
	txreq
	rxresp
	expect resp.http.via == \
		"1.1 v1 (Vinyl-Cache/${pkg_branch}), 1.1 v2 (Vinyl-Cache/${pkg_branch})"
} -run
