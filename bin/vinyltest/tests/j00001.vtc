vtest "Run worker with different uid in UNIX jail"

# The "vrun" user must have login group "vinyl"

feature user_vinyl
feature user_vcache
feature group_vinyl
feature root

server s1 {
	rxreq
	txresp
} -start

vinyl v1 \
	-jail "-junix,user=vinyl,ccgroup=vinyl,workuser=vcache" \
	-vcl+backend {
} -start

client c1 {
	txreq
	rxresp
	expect resp.status == 200
} -run
